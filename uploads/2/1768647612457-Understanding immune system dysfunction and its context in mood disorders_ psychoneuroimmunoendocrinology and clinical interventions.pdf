         <pdf:Keywords>Acute heart failure,Death,Hyperoxia,Mortality,Oxygen therapy</pdf:Keywords>
         <pdf:Producer>Acrobat Distiller 10.0.0 (Windows); modified using iTextÂ® 5.3.5 Â©2000-2012 1T3XT BVBA (SPRINGER SBM; licensed version)</pdf:Producer>
