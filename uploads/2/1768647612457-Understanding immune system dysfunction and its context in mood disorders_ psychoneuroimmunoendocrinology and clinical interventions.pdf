         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Is oxygen therapy beneficial for normoxemic patients with acute heart failure? A propensity score matched study</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Yue Yu</rdf:li>
               <rdf:li>Ren-Qi Yao</rdf:li>
